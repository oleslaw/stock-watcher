# Copy to .env (gitignored) for local runs, and set the same as repo secrets in CI.
# Keep the real values out of version control — the point is to not disclose the target.

# Pages to check. Newline- or comma-separated.
WATCH_URLS=https://example.com/categories/foo/,https://example.com/product-tags/bar/

# Page(s) scraped by --self-test (something usually in stock).
WATCH_SELF_TEST_URLS=https://example.com/categories/all/

# Optional. Defaults to scheme+host of the first WATCH_URLS entry.
WATCH_HOMEPAGE=https://example.com/

# Regex (IGNORECASE) matched against product names.
WANTED_PATTERN=\bfoo\b|\bbar\b

# Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
